{
  "disableAllHooks": false,
  "permissions": {
    "deny": [
      "Edit(//**/.claude/settings.json)",
      "Edit(//**/.claude/settings.local.json)",
      "Edit(//**/.claude/agents/reviewer.md)",
      "Edit(//**/.claude/hooks/**)",
      "Edit(//**/.claude/reviews/**)",
      "Agent(model:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh\" || exit 2"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/record-review.sh\""
          }
        ]
      }
    ]
  }
}
